{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aldus:schema:1.9:ArtifactRef",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producerRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "producerStageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "inputHashes": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "reconstructability": {
      "type": "string",
      "enum": [
        "source",
        "reproducible",
        "irreplaceable"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "artifactId",
    "kind",
    "uri",
    "sha256",
    "mediaType",
    "producerRunId",
    "producerStageId",
    "inputHashes",
    "reconstructability",
    "createdAt"
  ],
  "title": "ArtifactRef",
  "description": "A content-addressed reference to a produced artifact (architecture contract §8) — the stable boundary between stages. Path and filename are NOT identity (§8.1); `artifactId` plus `sha256` are. `kind` is an open string so adopters can introduce artifact kinds without changing Core. `reconstructability: irreplaceable` marks artifacts that MUST be archived before disposable working files are cleaned (§8.1)."
}
