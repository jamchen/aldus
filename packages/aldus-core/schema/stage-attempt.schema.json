{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aldus:schema:1.14:StageAttempt",
  "type": "object",
  "properties": {
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "stageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_for_gate",
        "failed",
        "succeeded",
        "cancelled"
      ]
    },
    "actor": {
      "$ref": "#/$defs/ActorRef"
    },
    "inputArtifacts": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "outputArtifacts": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "expectedArtifacts": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "minCount"
        ]
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "error": {
      "$ref": "#/$defs/StructuredError"
    }
  },
  "required": [
    "attemptId",
    "stageId",
    "attempt",
    "status",
    "actor",
    "inputArtifacts",
    "outputArtifacts"
  ],
  "title": "StageAttempt",
  "description": "One invocation of a stage (architecture contract §6.3). Append-only: a retry appends a new attempt rather than editing this one, so the history of what was tried survives. Input and output artifacts are recorded by value, which is what makes hash-bound approval invalidation (§13) possible. Carries no schemaVersion — it is embedded and inherits its container's version (ADR-0003).",
  "$defs": {
    "ActorRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "worker",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "backendId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sessionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "ActorRef",
      "description": "Identity of the party that performed an action (architecture contract §6.4, §19.2). Every mutating action records one. `backendId` and `sessionRef` are traceability metadata; contract §3.4 forbids treating an agent session as authoritative state."
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "producerRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "producerStageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "inputHashes": {
          "maxItems": 4096,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "producers": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "versionEvidence": {
                "type": "string",
                "enum": [
                  "reported",
                  "requested"
                ]
              }
            },
            "required": [
              "id",
              "version",
              "versionEvidence"
            ]
          }
        },
        "reconstructability": {
          "type": "string",
          "enum": [
            "source",
            "reproducible",
            "irreplaceable"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "schemaVersion",
        "artifactId",
        "kind",
        "uri",
        "sha256",
        "mediaType",
        "producerRunId",
        "producerStageId",
        "inputHashes",
        "reconstructability",
        "createdAt"
      ],
      "title": "ArtifactRef",
      "description": "A content-addressed reference to a produced artifact (architecture contract §8) — the stable boundary between stages. Path and filename are NOT identity (§8.1); `artifactId` plus `sha256` are. `kind` is an open string so adopters can introduce artifact kinds without changing Core. `reconstructability: irreplaceable` marks artifacts that MUST be archived before disposable working files are cleaned (§8.1)."
    },
    "StructuredError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "validation",
            "policy",
            "not_found",
            "conflict",
            "provider",
            "io",
            "timeout",
            "cancelled",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "causes": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuredError"
          }
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable"
      ],
      "title": "StructuredError",
      "description": "A redacted, safe-to-persist failure record (architecture contract §19.1). `message` and `details` are already redacted by the producer. Cause chains are bounded to 4 levels at construction time, a constraint JSON Schema cannot express."
    }
  }
}
