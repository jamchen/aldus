{
  "name": "@aldus-runtime/core",
  "version": "0.2.0-next.36",
  "type": "module",
  "description": "Aldus Core — domain types, JSON schemas, validation, IDs, and redaction. Generic runtime contracts only.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamchen/aldus.git",
    "directory": "packages/aldus-core"
  },
  "homepage": "https://github.com/jamchen/aldus/tree/main/packages/aldus-core#readme",
  "bugs": {
    "url": "https://github.com/jamchen/aldus/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "node --experimental-strip-types scripts/generate-json-schema.ts",
    "schema:check": "node --experimental-strip-types scripts/generate-json-schema.ts --check",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@types/node": "^26.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
