{
  "name": "@aldus/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aldus Core \u2014 domain types, JSON schemas, validation, IDs, and redaction. Generic runtime contracts only.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "node --experimental-strip-types scripts/generate-json-schema.ts",
    "schema:check": "node --experimental-strip-types scripts/generate-json-schema.ts --check",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
