  },
  "devDependencies": {
    "@aldus-runtime/file-store": "*",
    "@aldus-runtime/gate-engine": "*",
    "@aldus-runtime/stage-runner": "*",
    "@aldus-runtime/testkit": "*",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
