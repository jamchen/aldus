{
  "name": "@aldus-runtime/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aldus CLI \u2014 a thin adapter over @aldus-runtime/services (architecture contract \u00a718).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamchen/aldus",
    "directory": "packages/aldus-cli"
  },
  "homepage": "https://github.com/jamchen/aldus/tree/main/packages/aldus-cli#readme",
  "bugs": {
    "url": "https://github.com/jamchen/aldus/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "aldus": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b",
